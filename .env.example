# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
# LLM_PROVIDER selects which client get_llm() builds: "google" (default) or "groq".
LLM_PROVIDER=google
GOOGLE_API_KEY=AIzaSy-your-key-here
GROQ_API_KEY=
MODEL_NAME=gemini-2.5-flash
# Groq example: LLM_PROVIDER=groq, MODEL_NAME=openai/gpt-oss-20b (reliable tool-calling; get a key at https://console.groq.com/keys)
# Self-imposed daily token ceiling, purely for the usage warning on the Admin dashboard —
# not enforced by any provider, just an early-warning number you pick.
DAILY_TOKEN_BUDGET=200000

# ---- Database ----
# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///./data/app.db
# Or PostgreSQL — also gives the LangGraph agent persistent conversation memory that
# survives backend restarts (falls back to in-memory/lost-on-restart on SQLite):
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ---- Auth ----
SECRET_KEY=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Email that gets the "admin" role automatically on registration (bootstrap the first admin)
INITIAL_ADMIN_EMAIL=

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- Google Calendar ----
# Run scripts/google_oauth_setup.py once locally to generate the token file.
GOOGLE_CREDENTIALS_PATH=./secrets/credentials.json
GOOGLE_TOKEN_PATH=./secrets/token.json
GOOGLE_CALENDAR_ID=primary
CALENDAR_TIMEZONE=Asia/Ho_Chi_Minh
# How often (seconds) the backend polls Google Calendar for changes made outside the app (e.g.
# edited directly in Google Calendar) - real push notifications need a public HTTPS callback URL,
# which this project doesn't have without a real deployment, so this is the practical stand-in.
CALENDAR_POLL_INTERVAL_SECONDS=20

# ---- Reminders / Scheduler ----
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=f3p1dEOhD_z8qjjtbeCtb2t9ASMEliz-4juZfWe3ZPgCtPZp-LjWthBfeNU8d5dP
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
