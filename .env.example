# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in the values you need.
# Never commit .env to git.

# ---- LLM Configuration ----
# LLM_PROVIDER selects which client get_llm() builds: "google" (default) or "groq".
LLM_PROVIDER=google
GOOGLE_API_KEY=
GROQ_API_KEY=
MODEL_NAME=gemini-2.5-flash
# Groq example: LLM_PROVIDER=groq, MODEL_NAME=openai/gpt-oss-20b (reliable tool-calling; get a key at https://console.groq.com/keys)
# Self-imposed daily token ceiling, purely for the usage warning on the Admin dashboard —
# not enforced by any provider, just an early-warning number you pick.
DAILY_TOKEN_BUDGET=200000

# ---- Database ----
# PostgreSQL (recommended for team use and persistent LangGraph memory):
DATABASE_URL=postgresql+asyncpg://orbit:orbit-local-password@localhost:5432/orbit
# SQLite fallback for lightweight local development (agent memory is not persistent):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Auth ----
# Change this before production. Keep it secret.
SECRET_KEY=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: email that becomes admin automatically on first registration.
INITIAL_ADMIN_EMAIL=
# Required only when migrating legacy chat data and the old database has multiple admins.
BOOTSTRAP_OWNER_USER_ID=

# ---- App ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
# Allow the frontend dev server to call the backend.
CORS_ORIGINS=http://localhost:5173

# ---- Google Calendar ----
# Required only if you want to connect a real Google Calendar account.
GOOGLE_CREDENTIALS_PATH=./secrets/credentials.json
GOOGLE_TOKEN_PATH=./secrets/token.json
GOOGLE_CALENDAR_ID=primary
CALENDAR_TIMEZONE=Asia/Ho_Chi_Minh
# How often (seconds) the backend polls Google Calendar for changes made outside the app (e.g.
# edited directly in Google Calendar) - real push notifications need a public HTTPS callback URL,
# which this project doesn't have without a real deployment, so this is the practical stand-in.
CALENDAR_POLL_INTERVAL_SECONDS=20

# ---- Reminders / Scheduler ----
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Optional AI logging / tracing ----
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=ai20k-agent
# LANGCHAIN_TRACING_V2=true

# ---- Instructor-provided AI hook logging ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log
