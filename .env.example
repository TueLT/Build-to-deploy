# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in the values you need.
# Never commit .env to git.

# ---- Required for AI features ----
# Put your Groq API key here if you want AI chat / summarization.
GROQ_API_KEY=

# ---- Database ----
# PostgreSQL (recommended for team/production use):
DATABASE_URL=postgresql+asyncpg://orbit:orbit-local-password@localhost:5432/orbit
# SQLite fallback for lightweight local development:
# DATABASE_URL=sqlite:///./data/app.db

# ---- Auth ----
# Change this before production. Keep it secret.
SECRET_KEY=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: email that becomes admin automatically on first registration.
INITIAL_ADMIN_EMAIL=
# Required only when migrating legacy chat data and the old database has multiple admins.
BOOTSTRAP_OWNER_USER_ID=

# ---- App ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
# Allow the frontend dev server to call the backend.
CORS_ORIGINS=http://localhost:5173

# ---- Google Calendar ----
# Required only if you want to connect a real Google Calendar account.
GOOGLE_CREDENTIALS_PATH=./secrets/credentials.json
GOOGLE_TOKEN_PATH=./secrets/token.json
GOOGLE_CALENDAR_ID=primary
CALENDAR_TIMEZONE=Asia/Ho_Chi_Minh

# ---- Reminders / Scheduler ----
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Optional AI logging / tracing ----
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=ai20k-agent
# LANGCHAIN_TRACING_V2=true

# ---- Instructor-provided AI hook logging ----
# AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
# AI_LOG_API_KEY=
# AI_LOG_DIR=.ai-log
